# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email / OTP Verification (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_APP_PASSWORD=
EMAIL_FROM=
# Stripe Payments (Leave empty if testing without payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=